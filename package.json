{
  "name": "@fungi.computer/cli-version",
  "version": "0.0.2",
  "private": false,
  "author": "Levi <levi@technomancy.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fungi-computer/cli-version.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "docs/api",
    "docs/home.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "description": "Installed Fungi CLI version-output contract shared by the updater and deployment proofs",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "node test/stranger/runtime.mjs"
  },
  "dependencies": {
    "semver": "7.8.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/semver": "7.8.0",
    "typescript": "5.9.3"
  },
  "botanical": {
    "role": "package",
    "operations": {
      "build": "required",
      "lint": "required",
      "typecheck": "required",
      "test": "required",
      "docs": "required",
      "pack": "required",
      "smoke": "required",
      "stranger": "required"
    }
  }
}
